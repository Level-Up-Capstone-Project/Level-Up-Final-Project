{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "targetCareer", "skills"],
  "properties": {
    "requestId": {"type": "string", "format": "uuid"},
    "targetCareer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["careerID", "careerName"],
      "properties": {
        "careerID": {"type": "string", "format": "uuid"},
        "careerName": {"type": "string", "minLength": 1, "maxLength": 150}
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skillID", "skillName", "category", "importanceLevel", "isCoreSkill", "status", "resourceSlots", "existingResources"],
        "properties": {
          "skillID": {"type": "string", "format": "uuid"},
          "skillName": {"type": "string", "minLength": 1, "maxLength": 100},
          "category": {"type": ["string", "null"], "maxLength": 100},
          "importanceLevel": {"type": ["integer", "null"], "minimum": 0},
          "isCoreSkill": {"type": "boolean"},
          "status": {"enum": ["Missing", "Partial", "Have"]},
          "resourceSlots": {"type": "integer", "minimum": 0, "maximum": 3},
          "existingResources": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["resourceID", "resourceName", "provider", "url", "providerResourceID"],
              "properties": {
                "resourceID": {"type": "string", "format": "uuid"},
                "resourceName": {"type": "string", "minLength": 1, "maxLength": 200},
                "provider": {"type": "string", "minLength": 1, "maxLength": 100},
                "url": {"type": "string", "format": "uri", "maxLength": 500},
                "providerResourceID": {"type": ["string", "null"], "maxLength": 200}
              }
            }
          }
        }
      }
    }
  }
}
