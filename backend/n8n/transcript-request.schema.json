{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["careerName", "fileName", "transcriptText"],
  "properties": {
    "careerName": {"type": ["string", "null"], "maxLength": 100},
    "fileName": {"type": "string", "minLength": 1, "maxLength": 255},
    "transcriptText": {"type": "string", "minLength": 50, "maxLength": 200000}
  }
}
