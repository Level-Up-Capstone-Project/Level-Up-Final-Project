{
  "name": "level-up-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3000",
    "start": "next start --port 3000",
    "build": "next build --webpack",
    "build:android:web": "cross-env CAPACITOR_BUILD=true NEXT_PUBLIC_API_BASE_URL=https://api.levelupnow.co.za next build --webpack",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "typecheck": "tsc --noEmit",
    "start:places": "node server/places.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "cross-env": "^10.1.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
